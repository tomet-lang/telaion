// The files catasto manages in this workspace. Each key is a path here;
// `source` is where its canonical content comes from.

::upstreams{
  commonfiles: { git: "https://github.com/tomet-lang/commonfiles.git", rev: main, root: base }
  vocabularies: { git: "https://github.com/tomet-lang/vocabularies.git", rev: main, root: vocabularies }
  tomet-shelf: { git: "https://github.com/tomet-lang/tomet-shelf.git", rev: main, root: crates/tomet-shelf-icons/assets/icons/lucide }
}

"LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
"LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
".editorconfig": {
  source: { upstream: commonfiles, path: ".editorconfig" }
}
".envrc": {
  source: { upstream: commonfiles, path: ".envrc" }
}
".gitattributes": {
  source: { upstream: commonfiles, path: ".gitattributes" }
}
"nix/formatter.nix": {
  source: { upstream: commonfiles, path: "nix/formatter.nix" }
}
"tmtroot/schema/vocabularies/writ@1.0.0.vocabulary.tmt": {
  source: { upstream: vocabularies, path: "writ/writ@1.0.0.vocabulary.tmt" }
}
"packages/ui/vendor/lucide/sprite.svg": {
  source: { upstream: tomet-shelf, path: "sprite.svg" }
}
"packages/ui/vendor/lucide/LICENSE": {
  source: { upstream: tomet-shelf, path: "LICENSE" }
}
"packages/ui/LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
"packages/ui/LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
"packages/editor/LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
"packages/editor/LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
"packages/tomet/LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
"packages/tomet/LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
