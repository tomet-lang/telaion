{
  "name": "@telaion/primitives",
  "version": "0.1.5",
  "description": "Telaion primitives - themeless Svelte 5 primitives and design tokens for Tomet editors",
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "design-tokens",
    "primitives",
    "ui",
    "tomet"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/tomet-lang/telaion#readme",
  "bugs": {
    "url": "https://github.com/tomet-lang/telaion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomet-lang/telaion.git",
    "directory": "packages/primitives"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": "./src/icons.generated.ts"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "vendor/lucide/LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist --tsconfig ../../tsconfig.json",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./icons": {
        "types": "./dist/icons.generated.d.ts",
        "default": "./dist/icons.generated.js"
      }
    }
  },
  "dependencies": {
    "@telaion/theme": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
