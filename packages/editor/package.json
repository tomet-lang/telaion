{
  "name": "@telaion/editor",
  "version": "0.1.3",
  "description": "Telaion Editor - a CodeMirror 6 source editor frame with a document session and a storage adapter",
  "keywords": [
    "svelte",
    "svelte5",
    "editor",
    "codemirror",
    "tomet"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/tomet-lang/telaion#readme",
  "bugs": {
    "url": "https://github.com/tomet-lang/telaion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomet-lang/telaion.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist --tsconfig ../../tsconfig.json",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@telaion/ui": "workspace:^",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
